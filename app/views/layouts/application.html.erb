<!DOCTYPE html>
<html>
  <head>
    <title>NoGemSearchPractice</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body>
    <header>
      <nav class="nav-list">
        <% if logged_in? %>
          <%= link_to "新規料理", new_cooking_path %>
          <%= link_to "新規ジャンル", new_genre_path %>
          <%= link_to "料理一覧", cookings_path %>
          <%= button_to "ログアウト", logout_path, method: :delete, class: "logout-btn" %>
        <% else %>
          <%= link_to "サインアップ", signup_path %>
          <%= link_to "ログイン", login_path %>
        <% end %>
      </nav>
    </header>

    <main class="container">
      <%= yield %>
    </main>
  </body>
</html>
